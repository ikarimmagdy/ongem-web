{
  "name": "ongem-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --port 5190",
    "build": "tsc -b && node scripts/build.mjs",
    "preview": "vite preview --port 5190",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "api:paths": "node scripts/api-paths.mjs",
    "content:check": "node scripts/check-content.mjs",
    "content:snapshot": "node scripts/content-snapshot.mjs"
  },
  "dependencies": {
    "@clerk/react": "6.17.8",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "rrweb": "2.1.7",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "rrweb-snapshot": "2.1.7",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@clerk/shared": "4.40.0"
  }
}

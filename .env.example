# Clerk customer instance publishable key (public, never a secret key). Blank: demo mode only.
VITE_CLERK_PUBLISHABLE_KEY=
# API base; /api-dev is proxied to https://api-dev.ongem.com by the dev and preview servers and by CloudFront.
VITE_API_BASE_URL=/api-dev
# The other region's API base (OG-022 R25), asked when this build's region knows no company for the person.
# Blank: the other region's dev API (https://api-dev.ae.platform.ongem.com for the US build, https://api-dev.ongem.com for AE).
VITE_OTHER_REGION_API_BASE_URL=
# Public site (OG-034, PS-002, PS-014). `production` hides the draft disclosures and requires both site URLs below,
# https and not a development host, or the build stops. Blank: a dev or preview build on the dev sites.
VITE_ENVIRONMENT=
VITE_SITE_URL=
VITE_OTHER_SITE_URL=
# Public contact address; blank until OnGem names one (no write-to-us link is shown without it).
VITE_CONTACT_EMAIL=

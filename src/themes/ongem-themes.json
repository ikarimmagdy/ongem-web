        "category": {
          "banking": "#2F4BE8",
          "bankingBg": "#EEF1FE",
          "global": "#12936F",
          "globalBg": "#E9F8F3",
          "cards": "#5B3FD9",
          "cardsBg": "#F3F0FE",

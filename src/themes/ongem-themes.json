          "signature": "#5B3FD9",
          "signatureSoft": "#9B8AF2",
          "accent": "#1FB892",
          "info": "#3E8EE6",
          "gold": "#C8952E",
          "deep": "#0B1033"
        },
        "surface": {
          "canvas": "#FAFAFA",
          "card": "#FFFFFF",
          "raised": "#FFFFFF",
          "sunken": "#F4F4F5",
          "inverse": "#0B1033",
          "tintBlue": "#EEF1FE",
          "tintViolet": "#F3F0FE",
          "tintMint": "#E9F8F3"
        },
        "text": {
          "primary": "#0F1115",
          "secondary": "#4A4F59",
          "muted": "#6B7079",
          "inverse": "#FFFFFF",
          "link": "#2F4BE8",
          "money": "#0F1115"
        },
        "border": {
          "default": "#E6E6E9",
          "subtle": "#EFEFF1",
          "strong": "#7E828B",
          "focus": "#2F4BE8"
        },
        "action": {
          "primaryBg": "#2F4BE8",
          "primaryText": "#FFFFFF",
          "primaryHoverBg": "#2139C7",
          "secondaryBg": "#FFFFFF",
          "secondaryText": "#0F1115",
          "secondaryBorder": "#DADBDF",
          "dangerBg": "#D92D20",
          "dangerText": "#FFFFFF"
        },
        "status": {
          "success": "#067647",
          "successBg": "#ECFDF3",
          "pending": "#B54708",
          "pendingBg": "#FFFAEB",
          "failure": "#C4271B",
          "failureBg": "#FEF3F2",

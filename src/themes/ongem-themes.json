          "complianceBg": "#EAF3FD",
          "treasury": "#B07C17",
          "treasuryBg": "#FBF5E6"
        }
      },
      "gradient": {
        "brand": [
          "#0B1033",
          "#1B2470",
          "#2F4BE8",
          "#6E7BF2"
        ]
      },
      "typography": {
        "display": {
          "family": "'Inter', 'IBM Plex Sans Arabic', system-ui, sans-serif",
          "weight": 600,
          "tracking": "-0.025em"
        },
        "label": {
          "family": "'Inter', 'IBM Plex Sans Arabic', system-ui, sans-serif",
          "weight": 500,
          "transform": "none",
          "tracking": "0em"
        },
        "body": {
          "family": "'Inter', 'IBM Plex Sans Arabic', system-ui, sans-serif",
          "weight": 400
        },
        "bodyStrong": {
          "family": "'Inter', 'IBM Plex Sans Arabic', system-ui, sans-serif",
          "weight": 500
        },
        "money": {
          "family": "'Inter', 'IBM Plex Sans Arabic', system-ui, sans-serif",
          "weight": 600,
          "numeric": "tabular-nums"
        },
        "scale": {
          "xs": 12,
          "sm": 14,
          "md": 16,
          "lg": 18,
          "xl": 20,
          "2xl": 24,
          "3xl": 32,
          "4xl": 44,
          "5xl": 56
        }
      },
      "space": {
        "xs": 4,
        "sm": 8,
        "md": 16,
        "lg": 24,
        "xl": 32,
        "2xl": 48,
        "3xl": 64,
        "4xl": 96,
        "5xl": 128
      },
      "radius": {
        "sm": 8,
        "md": 12,
        "lg": 16,
        "xl": 20,
        "pill": 999
      },
      "shadow": {
        "card": "0 1px 2px rgba(15,17,21,0.04)",
        "raised": "0 8px 24px rgba(15,17,21,0.08)"
      },
      "logo": {
        "wordmark": "ongem-wordmark.png",
        "favicon": "ongem-favicon.png",
        "alt": "OnGem"
      },
      "rules": [
        "One family: Inter for everything (headings at tight tracking, weights 400, 500 and 600 only); IBM Plex Sans Arabic for Arabic; no condensed face",
        "Real neutrals: white page, #FAFAFA app canvas, one grey (#F4F4F5) for sunken areas; never grey text on a grey fill",
        "OnGem blue is the accent: the one filled button per view, links, focus and the active nav item; never a background band",
        "Deep navy (#0B1033) appears once per page at most, for the footer or one statement band; never both on one screen",
        "Primary text near-black, secondary #4A4F59 (8:1); muted only for meta text of 13 px and up",
        "Status colours stay conventional and separate from category colours; category tints only in Needs you and file icons",
        "Hairline borders before shadows; cards 16 to 20 px radius, controls 12, pill buttons on the public site",
        "Headings sentence case, weight 600, tracking -0.025em at 32 px and up, -0.01em below; numbers tabular",
        "Logo: full-colour wordmark on white, Ice on navy; at least 24 px tall",
        "Form controls use the strong border (3:1); cards keep the light border",
        "Sections 96 px apart on wide screens, 64 px on a phone; content measure 640 px for prose"
      ]
    },
